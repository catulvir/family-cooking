    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "27.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
