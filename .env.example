# PostgreSQL values for local Docker Compose and the Spring Boot application.
POSTGRES_DB=family_cooking
POSTGRES_USER=family_cooking
POSTGRES_PASSWORD=replace-with-a-local-password

# Spring Boot database connection. DATABASE_URL is useful for Render-managed PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=family_cooking
DB_USERNAME=family_cooking
DB_PASSWORD=replace-with-a-local-password
DATABASE_URL=jdbc:postgresql://localhost:5432/family_cooking
DB_SSL_MODE=prefer
DB_POOL_SIZE=5

# Optional first administrator. Leave the password blank unless you want the app
# to create rozbergs@gmail.com (or the email below) when it starts for the first time.
BOOTSTRAP_ADMIN_EMAIL=rozbergs@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false

